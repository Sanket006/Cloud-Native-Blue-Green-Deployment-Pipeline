pipeline {
    agent any
    
    environment {
        AWS_DEFAULT_REGION = "us-east-1"
        // Make sure the Jenkins agent has appropriate AWS IAM Roles or credentials configured
    }

    parameters {
        choice(name: 'ACTION', choices: ['Terraform Apply', 'Terraform Destroy', 'Deploy AWS App', 'Switch Traffic'], description: 'Action to perform')
        choice(name: 'TARGET_ENV', choices: ['blue', 'green'], description: 'Environment to switch traffic to (only used if ACTION is Switch Traffic)')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Terraform Apply') {
            when {
                expression { params.ACTION == 'Terraform Apply' }
            }
            steps {
                dir('terraform') {
                    sh 'terraform init'
                    sh 'terraform apply -auto-approve'
                }
            }
        }

        stage('Deploy App to AWS') {
            when {
                expression { params.ACTION == 'Deploy AWS App' }
            }
            steps {
                echo "Running AWS specific deployment..."
                sh 'chmod +x scripts/deploy-aws.sh'
                sh './scripts/deploy-aws.sh'
            }
        }

        stage('Switch Traffic') {
            when {
                expression { params.ACTION == 'Switch Traffic' }
            }
            steps {
                echo "Switching AWS cluster traffic to ${params.TARGET_ENV}..."
                // Assumes kubeconfig is already set from Deploy App to AWS step.
                // If run independently, re-run the 'aws eks update-kubeconfig' command first.
                sh 'chmod +x scripts/switch-traffic.sh'
                sh "./scripts/switch-traffic.sh ${params.TARGET_ENV}"
            }
        }

        stage('Terraform Destroy') {
            when {
                expression { params.ACTION == 'Terraform Destroy' }
            }
            steps {
                dir('terraform') {
                    sh 'terraform destroy -auto-approve'
                }
            }
        }
    }
}
